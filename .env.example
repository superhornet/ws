# Server
SERVER_PORT=3000
# Managed hosts (Render/Railway/Fly/Cloud Run/Heroku) inject PORT automatically
# and it takes precedence over SERVER_PORT. Leave unset locally.
# PORT=
# Number of proxy hops to trust for client IP (rate limiting). Set to 1 when
# running behind a single platform load balancer / reverse proxy in production.
# Leave unset for local/docker (no proxy).
# TRUST_PROXY=1
# Comma-separated list of allowed CORS origins (only needed for browser/Expo web;
# native iOS/Android apps do not enforce CORS). Defaults to local dev origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# PostgreSQL
# Managed hosts (e.g. Render) provide a single connection string. When set, it
# takes precedence over the discrete POSTGRES_* vars below. Leave unset locally.
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_HOST=localhost
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=your_database
POSTGRES_PORT=5432
# Set to true when connecting to a managed Postgres that requires TLS.
POSTGRES_SSL=false
# Set to true only when you provide a trusted CA bundle; defaults to false so
# provider-managed certs connect without manual CA setup.
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Optional (have defaults):
# Postgres pool tuning
POSTGRES_MAX=10                    # max pool connections (default: 10)
POSTGRES_IDLETIMEOUT=30000         # idle timeout in ms (default: 30000)
POSTGRES_CONNECTIONTIMEOUT=2000    # connection timeout in ms (default: 2000)

# OTP
OTP_HASH_SECRET=replace_with_a_long_random_secret
OTP_TTL_MINUTES=10
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Production delivery webhooks. The backend POSTs { channel, destination, purpose, code, expiresAt }.
OTP_SMS_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_URL=
OTP_PROVIDER_AUTH_TOKEN=
# Local/dev only. Ignored when NODE_ENV=production.
OTP_DEV_LOG=false
OTP_DEV_EXPOSE=false
# Dev-only: force every generated OTP to this fixed 6-digit code so the frontend
# can hardcode it while real delivery is wired up. Requires OTP_DEV_LOG=true or
# OTP_DEV_EXPOSE=true so /otp/.../start succeeds without a configured provider.
OTP_DEV_FIXED_CODE=

# Cybrid API
CYBRID_CLIENT_ID=your_cybrid_client_id
CYBRID_CLIENT_SECRET=your_cybrid_client_secret

# Cybrid endpoints (default to sandbox)
CYBRID_API_BASE=https://bank.sandbox.cybrid.app
CYBRID_AUTH_URL=https://id.sandbox.cybrid.app/oauth/token
