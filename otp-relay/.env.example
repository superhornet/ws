# Port the relay listens on
PORT=4000

# Shared secret. Must match the WeStack backend's OTP_PROVIDER_AUTH_TOKEN.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_AUTH_TOKEN=

# --- Twilio (SMS) ---
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use EITHER a Messaging Service SID (recommended) ...
TWILIO_MESSAGING_SERVICE_SID=
# ... OR a single sending number in E.164 (e.g. +15551234567)
TWILIO_FROM_NUMBER=

# --- SendGrid (email) ---
# Console: https://app.sendgrid.com
SENDGRID_API_KEY=
# Must be a verified sender / domain in SendGrid
SENDGRID_FROM_EMAIL=
